{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/*/scripts/*.py:*)",
      "Bash(python3 skill-lab/bin/skill-lab validate:*)",
      "Bash(python3 skill-lab/bin/skill-lab test:*)",
      "Bash(python3 skill-lab/bin/skill-lab bench:*)",
      "Bash(python3 skill-lab/bin/skill-lab doctor:*)",
      "Bash(python3 skill-lab/bin/skill-lab score:*)",
      "Bash(python3 skill-lab/bin/skill-lab catalog --check:*)",
      "Bash(python3 skill-lab/bin/skill-lab sync --check:*)",
      "Bash(python3 skill-lab/bin/skill-lab install --check:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Skill(lead-architect)",
      "Skill(pse-implementer)",
      "Skill(review-verifier)",
      "Skill(speckit-gitea-taskstoissues)",
      "Skill(speckit-gitea-sync)",
      "Skill(kanban-state-machine)",
      "Skill(work-lease)",
      "Skill(gitea-event-normalizer)",
      "Skill(merge-policy-gate)",
      "Skill(session-checkpoint)",
      "Skill(twelve-factor-audit)",
      "Skill(skill-forge)",
      "Skill(speckit-development)"
    ],
    "ask": [
      "Bash(python3 .claude/skills/* --apply*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "Bash(tea:*)",
      "Edit(/skill-lab/contracts/**)",
      "Edit(/skill-lab/benchmarks/criteria/**)",
      "Edit(/skill-lab/config/**)",
      "Edit(/skill-lab/shared/_skillkit/**)",
      "Edit(/skill-lab/docs/CONVENTIONS.md)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/skills/*/SKILL.md)",
      "Edit(/.claude/**)",
      "Edit(/.agents/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * *:main)",
      "Bash(git push * *:master)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(sh -s*)",
      "Bash(bash -s*)",
      "Edit(/.skill-policy.json)",
      "Edit(/.skill-gitea.json)",
      "Edit(/.github/workflows/**)",
      "Edit(/.gitea/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.zed/settings.json)",
      "Edit(CODEOWNERS)",
      "Edit(/skills/*/scripts/_skillkit/**)",
      "Edit(/skills/*/assets/schemas/**)",
      "Edit(/skills/CATALOG.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
