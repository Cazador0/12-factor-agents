      {
        "op": "eq",
        "path": "/errors/0/code",
        "value": "CHECK_NOT_EXECUTED"
      }
    ],
    "exit_code": 1,
    "schema_valid": true
  },
  "id": "rejects-unexecuted-evidence",
  "judgments": [],
