      "--input",
      "evals/fixtures/unexecuted.json"
    ],
    "script": "scripts/evidence_manifest.py"
  },
  "schema": "urn:skill-lab:schema:benchmark-case:v1",
  "skill": "pse-implementer",
  "tags": [
    "guardrail"
  ],
  "tier": "deterministic"
}
