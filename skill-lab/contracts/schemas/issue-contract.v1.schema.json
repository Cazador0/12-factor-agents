{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-lab:schema:issue-contract:v1",
  "title": "Issue contract",
  "description": "Everything an agent needs to reconstruct an issue's contract without a chat transcript: intent, spec and tasks, acceptance criteria, non-goals, dependencies, risk, required verification, write domains and ownership.",
  "type": "object",
  "required": [
    "schema_version",
    "issue_ref",
    "spec_id",
    "task_ids",
    "intent",
    "acceptance_criteria",
    "non_goals",
    "dependencies",
    "risk",
    "required_verification",
    "write_domains",
    "ownership"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract major version.",
      "type": "integer",
      "const": 1
    },
    "issue_ref": {
      "description": "Gitea issue number; null before the issue exists.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/line"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "feature": {
      "$ref": "#/$defs/feature"
    },
    "spec_id": {
      "$ref": "#/$defs/spec_id"
    },
    "story": {
      "description": "User story, e.g. US3.",
      "type": "string",
      "pattern": "^US[0-9]+$"
    },
    "task_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "intent": {
      "$ref": "#/$defs/text"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/ac_id"
          },
          "text": {
            "$ref": "#/$defs/line"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "description": "A blocking Gitea issue number or task ID.",
        "type": [
          "integer",
          "string"
        ],
        "minimum": 1,
        "pattern": "^T[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "required_verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Verification layers that must pass, e.g. unit, integration, browser-e2e, security-baseline."
    },
    "write_domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/write_domain"
      },
      "uniqueItems": true
    },
    "ownership": {
      "description": "Who owns each role for this issue; null when unassigned.",
      "type": "object",
      "required": [
        "lead",
        "pse",
        "review"
      ],
      "properties": {
        "lead": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "pse": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "review": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "current_pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ac_id": {
      "description": "Acceptance-criterion ID, e.g. AC-01.",
      "type": "string",
      "pattern": "^AC-[0-9]{2,}$"
    },
    "feature": {
      "description": "Feature directory name under specs/, e.g. 042-session-refresh.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "identifier": {
      "description": "Short stable identifier, e.g. unit, B-01, has-acceptance-criteria.",
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([._:-][A-Za-z0-9]+)*$",
      "maxLength": 100
    },
    "line": {
      "description": "One line of text (no line breaks), at most 500 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "repository": {
      "description": "Repository as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "risk": {
      "description": "Risk class (engineering report, risk-based escalation).",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "spec_id": {
      "description": "Specification ID, e.g. SPEC-042.",
      "type": "string",
      "pattern": "^SPEC-[0-9]{3}$"
    },
    "task_id": {
      "description": "Spec Kit task ID, e.g. T001.",
      "type": "string",
      "pattern": "^T[0-9]{3,}$"
    },
    "text": {
      "description": "Free text, at most 4000 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "write_domain": {
      "description": "Repository-relative glob a task may write, e.g. packages/auth/**.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00]+$"
    }
  }
}
