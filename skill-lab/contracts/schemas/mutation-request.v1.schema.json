{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-lab:schema:mutation-request:v1",
  "title": "Mutation request",
  "description": "A consequential write any role asks the control plane to perform. Carries authority (actor_role, session_id), optimistic concurrency (expected_version) and an idempotency key so a retried write cannot apply twice.",
  "type": "object",
  "required": [
    "schema_version",
    "actor_role",
    "session_id",
    "target",
    "action",
    "expected_version",
    "idempotency_key",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract major version.",
      "type": "integer",
      "const": 1
    },
    "actor_role": {
      "$ref": "#/$defs/actor_role"
    },
    "session_id": {
      "$ref": "#/$defs/session_id"
    },
    "target": {
      "description": "What the mutation changes.",
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "issue",
            "pull_request",
            "project",
            "branch",
            "lease",
            "label",
            "comment",
            "review"
          ]
        },
        "id": {
          "description": "Issue/PR number, or a name for branches, labels and leases.",
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "action": {
      "description": "Semantic operation, e.g. issue.move, issue.comment, pr.enable_auto_merge, lease.claim. Never a raw HTTP request.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 100
    },
    "expected_version": {
      "description": "Version of the target as last read (optimistic concurrency); null only when the target does not exist yet.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "idempotency_key": {
      "$ref": "#/$defs/idempotency_key"
    },
    "reason": {
      "$ref": "#/$defs/line"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "lease_id": {
      "description": "Lease that authorises the write, when one is required.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "params": {
      "description": "Action-specific arguments (open object), e.g. {\"to_state\": \"REVIEW\"}; the control plane validates them per action.",
      "type": "object",
      "additionalProperties": true
    },
    "requested_at": {
      "$ref": "#/$defs/date_time"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "actor_role": {
      "description": "Role that acts or owns the work.",
      "enum": [
        "lead",
        "pse",
        "review",
        "system"
      ]
    },
    "date_time": {
      "description": "RFC 3339 timestamp; producers emit YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "description": "Key that makes a retried mutation a no-op; derived deterministically from the inputs when not given.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "line": {
      "description": "One line of text (no line breaks), at most 500 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "repository": {
      "description": "Repository as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    },
    "session_id": {
      "description": "Agent session identifier.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
