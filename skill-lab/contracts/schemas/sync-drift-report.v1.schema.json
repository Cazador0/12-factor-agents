{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-lab:schema:sync-drift-report:v1",
  "title": "Sync drift report",
  "description": "Differences between tasks.md, the task-issue map and Gitea. The sync reports drift; it never rewrites the spec. in_sync is true exactly when drift is empty.",
  "type": "object",
  "required": [
    "schema_version",
    "feature",
    "repository",
    "in_sync",
    "drift",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract major version.",
      "type": "integer",
      "const": 1
    },
    "feature": {
      "$ref": "#/$defs/feature"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "map_path": {
      "$ref": "#/$defs/rel_path"
    },
    "in_sync": {
      "type": "boolean"
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail"
        ],
        "properties": {
          "kind": {
            "description": "missing_issue: task has no mapped issue; orphan_issue: issue claims a task not in tasks.md; stale_mapping: map entry for a removed task; issue_not_found: mapped issue missing in Gitea; duplicate_issue: several issues for one task; *_mismatch: title, dependencies or open/closed state differ.",
            "enum": [
              "missing_issue",
              "orphan_issue",
              "stale_mapping",
              "issue_not_found",
              "duplicate_issue",
              "title_mismatch",
              "dependency_mismatch",
              "state_mismatch"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^T[0-9]{3,}$"
          },
          "issue": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "detail": {
            "$ref": "#/$defs/line"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "description": "Drift count per kind (keys are drift kinds; zero counts may be omitted).",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "checked_at": {
      "$ref": "#/$defs/date_time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "in_sync is true exactly when drift is empty.",
      "oneOf": [
        {
          "description": "In sync: no drift.",
          "properties": {
            "in_sync": {
              "const": true
            },
            "drift": {
              "maxItems": 0
            }
          }
        },
        {
          "description": "Out of sync: at least one drift item.",
          "properties": {
            "in_sync": {
              "const": false
            },
            "drift": {
              "minItems": 1
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "date_time": {
      "description": "RFC 3339 timestamp; producers emit YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "format": "date-time"
    },
    "feature": {
      "description": "Feature directory name under specs/, e.g. 042-session-refresh.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "line": {
      "description": "One line of text (no line breaks), at most 500 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "rel_path": {
      "description": "Relative path with '/' separators; no leading '/', drive letter, '..' segment or backslash.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00]+$"
    },
    "repository": {
      "description": "Repository as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "maxLength": 200
    }
  }
}
